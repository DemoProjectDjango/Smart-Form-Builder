<apex:page controller="FormController"
           sidebar="false"
           showHeader="false"
           standardStylesheets="false"
           cache="false"
           applyBodyTag="false"
           applyHtmlTag="false">
<html>
<head>
    <apex:includeScript value="{!$Resource.DOMPurify}"/>
</head>
<body>

    <!-- Form Not Found state -->
    <apex:outputPanel rendered="{!ISNULL(formRec)}">
        <div style="padding:60px;text-align:center;background:#fef2f2;color:#991b1b;border-radius:8px;max-width:500px;margin:40px auto;">
            <h2>Form Not Found</h2>
            <p>The form ID may be incorrect or the form no longer exists.</p>
        </div>
    </apex:outputPanel>

    <!--
        SECURITY NOTE FOR APPEXCHANGE REVIEW:

        No VF expression appears inside a script block.
        Form data is passed via a hidden element's data attribute,
        using VF's default HTML attribute encoding (no escape="false").

        The data flow is:
          1. FormController.formPayloadJson builds a JSON string of
             sanitized HTML/CSS/JS (sanitizeHtml, sanitizeCss, sanitizeJs)
          2. URLENCODE() percent-encodes every special character so the
             value is safe in any HTML context
          3. VF's default attribute escaping provides a second encoding pass
          4. JavaScript reads the attribute value, decodes it, and parses JSON
          5. DOMPurify sanitizes the HTML before DOM insertion

        Result: zero escape="false" usage, zero VF expressions in script blocks.
    -->
    <apex:outputPanel rendered="{!NOT(ISNULL(formRec))}">
        <div id="sf-form-payload"
             data-v="{!URLENCODE(formPayloadJson)}"
             style="display:none">
        </div>
    </apex:outputPanel>

    <div id="sf-form-root"></div>

    <!--
        Cloudflare Turnstile widget script. Rendered only for forms that require a captcha and only
        when spam protection is connected. The URL is a fixed literal (no VF expression); the token the
        widget produces is verified server-side in FormController.saveSubmission before anything is stored.
    -->
    <apex:outputPanel rendered="{!showCaptcha}" layout="none">
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async="async" defer="defer"></script>
    </apex:outputPanel>

    <script>
        var SAVE_SUBMISSION_ACTION = '{!$RemoteAction.FormController.saveSubmission}';

        var SF_FORM_PAYLOAD = (function() {
            try {
                var el = document.getElementById('sf-form-payload');
                if (!el) { return {}; }
                var encoded = el.getAttribute('data-v');
                if (!encoded) { return {}; }
                return JSON.parse(decodeURIComponent(encoded.replace(/\+/g, ' ')));
            } catch(e) {
                return {};
            }
        })();

        (function() {
            if (!SF_FORM_PAYLOAD) { return; }
            if (!SF_FORM_PAYLOAD.id) { return; }

            if (SF_FORM_PAYLOAD.css) {
                var styleEl = document.createElement('style');
                styleEl.textContent = SF_FORM_PAYLOAD.css;
                document.head.appendChild(styleEl);
            }

            var root = document.getElementById('sf-form-root');
            if (root) {
                if (SF_FORM_PAYLOAD.html) {
                    root.innerHTML = DOMPurify.sanitize(SF_FORM_PAYLOAD.html, {
                        ADD_ATTR: ['data-field', 'data-type', 'data-required', 'data-object', 'data-label']
                    });
                }
            }

            if (SF_FORM_PAYLOAD.js) {
                try {
                    (new Function(SF_FORM_PAYLOAD.js))();
                } catch(e) {
                    console.warn('SmartForms: form script error', e);
                }
            }
        })();
    </script>

</body>
</html>
</apex:page>