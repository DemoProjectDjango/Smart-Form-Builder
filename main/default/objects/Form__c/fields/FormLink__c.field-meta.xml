<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FormLink__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
            ISBLANK($Setup.Form_Builder_Settings__c.Public_Form_Base_Url__c),
            NULL,
            HYPERLINK(
                $Setup.Form_Builder_Settings__c.Public_Form_Base_Url__c &amp; Id,
                &quot;Click Me&quot;,
                &quot;_blank&quot;
            )
        )</formula>
    <label>FormLink</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
